{
  "name": "neo-manuscript",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "e2e": "bun run build && bun test e2e",
    "harness": "bun run build && bun e2e/harness.ts",
    "app": "electrobun dev",
    "app:prepare": "electrobun prepare",
    "app:build": "electrobun build --env=stable"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.99.1",
    "@agentclientprotocol/sdk": "^2.2.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.17",
    "fast-diff": "^1.3.0",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299",
    "pi-acp": "^0.0.34"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "electrobun": "^2.0.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "wndb-with-exceptions": "3.0.2"
  }
}
