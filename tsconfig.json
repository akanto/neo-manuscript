{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "electrobun": [
        "./.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun/bun": [
        "./.hutch/devkit/api/sdks/main/index.ts"
      ]
    }
  },
  "include": [
    "core",
    "hosts",
    "view",
    "tests",
    "scripts",
    "e2e"
  ]
}
